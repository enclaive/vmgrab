# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Build output — never commit compiled binaries. A committed binary also
# embeds the builder's local module paths.
bin/
dist/

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool
*.out
*.prof

# Go workspace file
go.work
go.work.sum

# Dependency directories
vendor/

# Memory dump files
*.dump
*.bin
*.raw

# Config files (keep example only)
.vmgrab.yaml

# Test secrets — never commit kubeconfigs or SSH keys
tests/secrets/
*.kubeconfig
kubeconfig
*_rsa
*_ed25519
enclaivessh

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Local working notes and drafts, not part of the project
MESSAGE-*.md
NOTES-*.md

# Local test plans and run logs: they record specific hosts and targets
tests/PLAN.md
tests/RESULTS.md
